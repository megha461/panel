# Engine — all optional. With none of these set, Panel runs its keyless
# heuristic reasoner and stores history in ./data/panel.db.

# Enables the Claude reasoner. Without it, scores are indicative rather than
# defensible (see the README).
ANTHROPIC_API_KEY=

# Model override. Defaults to claude-opus-5.
PANEL_MODEL=

# Where interview history is written. Defaults to ./data/panel.db.
PANEL_DB=

# Browser origins allowed to call the API, comma-separated. Defaults to the
# local Vite dev server. In a deployment this must include the frontend's URL.
PANEL_CORS_ORIGINS=

# --- Frontend (build-time, read by Vite) -------------------------------------
# The engine's origin. Leave empty for local development, where Vite proxies
# /api to the local engine instead.
VITE_API_URL=
